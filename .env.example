# ──────────────────────────────────────────────────────────────
# CV PII Tool — Environment Configuration
# Copy to .env and customise. Never commit .env to git.
# ──────────────────────────────────────────────────────────────

# --- Ollama (Layer 3 LLM verification) ---
# Local Ollama endpoint. Default works for most setups.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60

# --- GLiNER (Layer 2 NER) ---
# Hugging Face model ID for the multilingual PII model.
# Override only if you've fine-tuned a custom variant.
GLINER_MODEL_ID=urchade/gliner_multi_pii-v1
GLINER_THRESHOLD=0.5

# Local path to pre-downloaded GLiNER model (offline / corporate use).
# When set and the folder exists, the model is loaded from here instead
# of being downloaded from Hugging Face. Run scripts/download_models_offline.py
# to populate this folder.
GLINER_MODEL_PATH=./models/gliner_multi_pii-v1

# Optional: URL to a zip of the model hosted in your own infrastructure
# (private GitHub release, Azure Blob Storage, internal Artifactory, etc.).
# Used by scripts/download_models_offline.py as the primary source.
# Examples:
#   GLINER_MODEL_SOURCE=https://github.com/yourorg/cv-pii-tool/releases/download/models-v1.0.0/gliner_multi_pii-v1.zip
#   GLINER_MODEL_SOURCE=https://yourstorage.blob.core.windows.net/ml-models/gliner_multi_pii-v1.zip
GLINER_MODEL_SOURCE=

# --- Hugging Face Offline Mode (corporate / air-gapped networks) ---
# Set to 1 to disable ALL network calls from huggingface_hub and transformers
# libraries. Use when the GLiNER model is pre-downloaded locally.
# Leave as 0 if internet access to huggingface.co is available.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# --- Corporate Proxy (optional) ---
# Set these only if your machine is behind a corporate HTTP proxy.
# Format: http://username:password@proxy.company.com:8080
# Leave empty if you have direct internet access.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,.local

# Path to corporate CA certificate bundle (.pem or .crt).
# Required only if your proxy uses TLS/SSL inspection. Ask your IT team.
# Common locations:
#   Linux:   /etc/ssl/certs/ca-certificates.crt
#   Windows: C:\ProgramData\YourCompany\ca-bundle.pem
REQUESTS_CA_BUNDLE=
SSL_CERT_FILE=

# --- Pipeline Behaviour ---
# How aggressively to apply the OCR normaliser.
# auto = detect damage and apply only when needed (recommended)
# always = apply unconditionally (use for known-bad sources)
# never = skip normaliser entirely
NORMALISE_MODE=auto

# Confidence threshold below which detections are flagged for
# human review in the detection_log.json.
CONFIDENCE_THRESHOLD=0.85

# --- Paths ---
# Override default folders if needed.
INPUT_DIR=./input
OUTPUT_DIR=./output

# --- Parallelism ---
# How many CVs to process concurrently. Set to 1 for debugging.
WORKERS=4

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO